# ---------------------------------------------------------------------------
# Admin gate for /setup-api
# ---------------------------------------------------------------------------
# Without these, /setup-api stays locked and nobody can reach the key form.
# Generate the digest with:
#
#   npm run hash-password 'your-password'
#
# Only the SHA-256 digest is shipped — never the password itself.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD_HASH=aa5d1af9a9367b510e43880d8f95f35700a7a043cc33cc454af0f8b8b832a70f

# ---------------------------------------------------------------------------
# Optional: bake in the API key at build time
# ---------------------------------------------------------------------------
# WARNING: this is a STATIC site. Anything in a VITE_* variable is compiled
# into the public JavaScript bundle and is readable by any visitor. Use it only
# for a private deployment, or with a disposable rate-limited key.
#
# The usual route is to leave this empty and set the key through /setup-api,
# which stores it in your own browser instead of publishing it.
VITE_OPENROUTER_API_KEY=
